{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sam",
  "version": "0.1.2",
  "identifier": "ai.sam.ambient",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../src/sam_ambient/static"
  },
  "app": {
    "windows": [
      {
        "title": "Sam",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:8765; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": false }
}
